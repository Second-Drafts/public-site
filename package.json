{
	"name": "public-site",
	"version": "1.0.0",
	"description": "Public site for The Department of Second Drafts",
	"homepage": "https://github.com/Second-Drafts/public-site#readme",
	"bugs": {
		"url": "https://github.com/Second-Drafts/public-site/issues"
	},
	"license": "ISC",
	"author": "",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Second-Drafts/public-site.git"
	},
	"main": "index.js",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint src",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"og": "node scripts/og/render.js",
		"fonts": ".venv-fonts/bin/python -I scripts/fonts/build.py",
		"predeploy": "npm run lint && npm run build",
		"deploy": "node scripts/deploy.js"
	},
	"dependencies": {
		"@astrojs/sitemap": "^3.7.4",
		"lz-string": "^1.5.0"
	},
	"devDependencies": {
		"astro": "^7.3.5",
		"gh-pages": "^6.1.1",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
