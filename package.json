{
	"name": "public-site",
	"version": "1.0.0",
	"description": "Public site for The Department of Second Drafts",
	"homepage": "https://github.com/Second-Drafts/public-site#readme",
	"bugs": {
		"url": "https://github.com/Second-Drafts/public-site/issues"
	},
	"license": "ISC",
	"author": "",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Second-Drafts/public-site.git"
	},
	"type": "module",
	"main": "index.js",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && tsc --noEmit -p workers/forms",
		"lint": "oxlint src workers",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"privacy:lock": "node scripts/privacy-lock.ts",
		"privacy:scan": "node scripts/privacy-scan.ts",
		"privacy:records": "node scripts/privacy-records-check.ts",
		"spacing:check": "node scripts/spacing-check.ts",
		"og": "node scripts/og/render.js",
		"fonts": ".venv-fonts/bin/python -I scripts/fonts/build.py",
		"predeploy": "npm run deploy:preflight && npm run privacy:records && npm run lint && npm test && npm run build && npm run spacing:check && npm run privacy:scan",
		"deploy:preflight": "node scripts/deploy-preflight.ts",
		"deploy": "node scripts/deploy.js",
		"forms:dev": "wrangler d1 migrations apply forms --local -c workers/forms/wrangler.jsonc && wrangler dev -c workers/forms/wrangler.jsonc --var ALLOWED_ORIGIN:http://localhost:4321",
		"forms:deploy": "wrangler d1 migrations apply forms --remote -c workers/forms/wrangler.jsonc && wrangler deploy -c workers/forms/wrangler.jsonc"
	},
	"dependencies": {
		"@astrojs/sitemap": "^3.7.4",
		"lz-string": "^1.5.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261016.1",
		"astro": "^7.3.8",
		"gh-pages": "^6.1.1",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"playwright": "^1.64.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3",
		"wrangler": "^4.151.1"
	},
	"engines": {
		"node": ">=24"
	}
}
