{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-on-edit.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "second-drafts-kit": {
      "source": {
        "source": "github",
        "repo": "Second-Drafts/second-drafts-kit"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "engineering@second-drafts-kit": true,
    "brand@second-drafts-kit": true
  }
}
