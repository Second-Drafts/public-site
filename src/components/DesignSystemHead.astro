---
/*
 * Loads the design system: tokens, global rules and the three self-hosted fonts.
 * Put it inside a layout's <head>. Components bring their own styles.
 *
 * Theme: an explicit data-theme always wins. Without one, the reader's system setting picks Paper or Night shift
 * through /theme-defaults.css (see src/styles/theme-defaults.ts), and the browser's own chrome follows it.
 */
import josefinSans from "../../brand/fonts/josefin-sans.woff2?url";
import literata from "../../brand/fonts/literata.woff2?url";
import tokens from "../../brand/foundation/tokens.json";
import "../styles/design-system.css";

const paper = tokens.color.tokens.find((token) => token.name === "paper")!.value;
---

<link rel="preload" href={literata} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={josefinSans} as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href="/theme-defaults.css" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content={paper.light} />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content={paper.dark} />
