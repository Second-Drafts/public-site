---
/*
 * SoonTag — marks a tool or feature that isn't built yet.
 *
 *   <SoonTag />
 */
---

<span class="soon-tag">Soon</span>

<style>
	/* Josefin rides high */
	.soon-tag {
		font-family: var(--font-display);
		font-size: 11px;
		line-height: 14px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-muted);
		border: var(--stroke-hairline) solid var(--rule-strong);
		border-radius: var(--radius-pill);
		padding: 3px var(--space-2) 1px;
		white-space: nowrap;
	}
</style>
