---
/*
 * BlogListing — the blog page: its header, the category filter, and the posts it lets through.
 * Every listing shares the same header, so switching categories or desks only changes what's beneath it.
 *
 *   <BlogListing category="craft" />
 *   <BlogListing desk="editorial" />
 */
import { getPublishedPosts } from "../lib/blog";
import { CATEGORIES, type CategoryKey, DESKS, type DeskKey, deskAboutPath } from "../lib/blog-taxonomy";
import CategoryNav from "./CategoryNav.astro";
import Link from "./Link.astro";
import PageHeader from "./PageHeader.astro";
import PostList from "./PostList.astro";

interface Props {
	category?: CategoryKey;
	desk?: DeskKey;
}

const { category, desk } = Astro.props;
const posts = (await getPublishedPosts()).filter(
	(post) => (!category || post.data.category === category) && (!desk || post.data.author === desk),
);
---

<PageHeader title="Memos from the Department">
	Thoughts on writing, editing, and storytelling, and the current state of the Department.
</PageHeader>

<CategoryNav current={category ?? (desk ? undefined : "all")} />

<div class="listing">
	{category && <p class="filter-description">{CATEGORIES[category].description}</p>}
	{
		desk && (
			<p class="filter-description">
				<strong>{DESKS[desk].name}.</strong> {DESKS[desk].description}{" "}
				<Link href={deskAboutPath(desk)}>About the desks</Link>
			</p>
		)
	}
	{posts.length > 0 ? <PostList posts={posts} /> : <p class="empty">We're still drafting. Check back soon.</p>}
</div>

<p class="feed">Follow along in your reader with the <Link href="/rss.xml">RSS feed</Link>.</p>

<style>
	@media (prefers-reduced-motion: no-preference) {
		@view-transition {
			navigation: auto;
		}
	}
	.listing {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
		margin-block-start: var(--space-6);
	}
	p {
		margin: 0;
		color: var(--ink-muted);
	}
	.filter-description {
		padding-block-end: var(--space-6);
		border-block-end: var(--stroke-hairline) solid var(--rule);
		color: var(--ink);
		text-wrap: pretty;
	}
	.filter-description strong {
		font-weight: 600;
	}
	.feed {
		margin-block-start: var(--space-12);
	}
</style>
