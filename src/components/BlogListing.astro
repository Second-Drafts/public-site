---
/*
 * BlogListing — the blog page: its header, the category filter, and the posts it lets through.
 * Every listing shares the same header, so switching categories only changes what's beneath it.
 *
 *   <BlogListing category="craft" />
 */
import { getPublishedPosts } from "../lib/blog";
import { CATEGORIES, type CategoryKey } from "../lib/blog-taxonomy";
import CategoryNav from "./CategoryNav.astro";
import Link from "./Link.astro";
import PageHeader from "./PageHeader.astro";
import PostList from "./PostList.astro";

interface Props {
	category?: CategoryKey;
}

const { category } = Astro.props;
const allPosts = await getPublishedPosts();
const posts = category ? allPosts.filter((post) => post.data.category === category) : allPosts;
---

<PageHeader title="Memos from the Department">
	Thoughts on writing, editing, and storytelling, and the current state of the Department.
</PageHeader>

<CategoryNav current={category} />

<div class="listing">
	{category && <p class="category-description">{CATEGORIES[category].description}</p>}
	{posts.length > 0 ? <PostList posts={posts} /> : <p class="empty">Nothing here yet. Check back soon.</p>}
</div>

<p class="feed">Follow along in your reader with the <Link href="/rss.xml">RSS feed</Link>.</p>

<style>
	@media (prefers-reduced-motion: no-preference) {
		@view-transition {
			navigation: auto;
		}
	}
	.listing {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
		margin-block-start: var(--space-6);
	}
	p {
		margin: 0;
		color: var(--ink-muted);
	}
	.category-description {
		padding-block-end: var(--space-6);
		border-block-end: var(--stroke-hairline) solid var(--rule);
		color: var(--ink);
	}
	.feed {
		margin-block-start: var(--space-12);
	}
</style>
