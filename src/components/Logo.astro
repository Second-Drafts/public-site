---
/*
 * Logo — the Department's lockup, with its clear space built in, or the one-line header wordmark.
 * Rules: DESIGN.md → Logo.
 *
 *   <Logo />                        full lockup, 240px wide
 *   <Logo width={320} />
 *   <Logo variant="header" />       one-line wordmark for site headers, 32px tall
 *   <Logo variant="header" height={28} />
 *
 * Lockup: logo.svg on Paper and the Highlighted band, logo-white.svg on Night shift.
 * Header: sd-word-single_line-marked.svg / sd-word-single_line-marked-night.svg, same theme rules.
 * Both images are in the page and CSS shows the one that matches the nearest [data-theme].
 * Never recolour or animate it.
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"span">, "style"> {
	/** "lockup" (default): the full stacked logo. "header": the one-line wordmark for site headers. */
	variant?: "lockup" | "header";
	/** Lockup only: width of the artwork in px. Never below 160. */
	width?: number;
	/** Header only: height of the wordmark in px. Default 32, never below 24. */
	height?: number;
	alt?: string;
}

const {
	variant = "lockup",
	width: requestedWidth = 240,
	height: requestedHeight = 32,
	alt = "The Department of Second Drafts",
	class: className,
	...rest
} = Astro.props;

let width: number, height: number, clearSpace: number, paperSrc: string, nightSrc: string;
if (variant === "header") {
	// one-line wordmark, viewBox 570 × 48; spacing comes from the header around it
	height = Math.max(24, requestedHeight);
	width = Math.round(height * (570 / 48));
	clearSpace = 0;
	paperSrc = "/img/sd-word-single_line-marked.svg";
	nightSrc = "/img/sd-word-single_line-marked-night.svg";
} else {
	// stacked lockup, viewBox 639 × 332; clear space all round = height of the "D" in DEPARTMENT (48 of 639 units)
	width = Math.max(160, requestedWidth);
	height = Math.round(width * (332 / 639));
	clearSpace = Math.round(width * (48 / 639));
	paperSrc = "/img/logo.svg";
	nightSrc = "/img/logo-white.svg";
}
---

<span {...rest} class:list={["sd-logo", `sd-logo--${variant}`, className]} style={`padding: ${clearSpace}px`}>
	<img class="sd-logo__img sd-logo__img--paper" src={paperSrc} width={width} height={height} alt={alt} />
	<img class="sd-logo__img sd-logo__img--night" src={nightSrc} width={width} height={height} alt={alt} />
</span>

<style>
	.sd-logo {
		display: inline-block;
		max-width: 100%;
		box-sizing: border-box;
	}
	.sd-logo__img {
		display: block;
		max-width: 100%;
		height: auto;
	}
	.sd-logo--lockup .sd-logo__img {
		min-width: 160px;
	}
	.sd-logo__img--night {
		display: none;
	}
	:global([data-theme="dark"]) .sd-logo__img--paper {
		display: none;
	}
	:global([data-theme="dark"]) .sd-logo__img--night {
		display: block;
	}
	/* a Paper or Highlighted surface inside Night shift goes back to the black-ink logo */
	:global([data-theme="dark"] :is([data-theme="light"], [data-theme="highlighted"])) .sd-logo__img--paper {
		display: block;
	}
	:global([data-theme="dark"] :is([data-theme="light"], [data-theme="highlighted"])) .sd-logo__img--night {
		display: none;
	}
	/* no data-theme on the page: follow the reader's system setting, as the tokens do */
	@media screen and (prefers-color-scheme: dark) {
		:global(:root:not([data-theme])) .sd-logo__img--paper {
			display: none;
		}
		:global(:root:not([data-theme])) .sd-logo__img--night {
			display: block;
		}
		:global(:root:not([data-theme]) :is([data-theme="light"], [data-theme="highlighted"])) .sd-logo__img--paper {
			display: block;
		}
		:global(:root:not([data-theme]) :is([data-theme="light"], [data-theme="highlighted"])) .sd-logo__img--night {
			display: none;
		}
	}
	/* print is always Paper */
	@media print {
		.sd-logo__img--paper {
			display: block !important;
		}
		.sd-logo__img--night {
			display: none !important;
		}
	}
</style>
