---
/*
 * PostList — blog posts as a list of titles, bylines, and descriptions, newest first.
 *
 *   <PostList posts={await getPublishedPosts()} />
 */
import type { CollectionEntry } from "astro:content";
import Link from "./Link.astro";
import PostMeta from "./PostMeta.astro";

interface Props {
	posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

<ul class="posts">
	{
		posts.map((post) => (
			<li>
				<Link href={`/blog/${post.id}/`} class="sd-text-heading">
					{post.data.title}
				</Link>
				<PostMeta author={post.data.author} category={post.data.category} date={post.data.date} />
				<p>{post.data.description}</p>
			</li>
		))
	}
</ul>

<style>
	.posts {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		display: flex;
		flex-direction: column;
		align-items: start;
		gap: var(--space-2);
	}
	p {
		margin: 0;
	}
</style>
