---
/*
 * CategoryNav — filters the blog by category: "All posts" and then each category that has posts, the one being shown filled in ink.
 *
 *   <CategoryNav current="craft" />
 */
import { getPublishedCategories } from "../lib/blog";
import { CATEGORIES, type CategoryKey, categoryPath } from "../lib/blog-taxonomy";

interface Props {
	current?: CategoryKey;
}

const { current } = Astro.props;

const filters = [
	{ href: "/blog/", label: "All posts", selected: current === undefined },
	...(await getPublishedCategories()).map((category) => ({
		href: categoryPath(category),
		label: CATEGORIES[category].label,
		selected: category === current,
	})),
];
---

<nav class="category-nav" aria-label="Filter posts by category">
	<ul>
		{
			filters.map((filter) => (
				<li>
					<a href={filter.href} aria-current={filter.selected ? "page" : undefined}>
						{filter.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	a {
		display: inline-flex;
		align-items: center;
		padding: var(--space-1) var(--space-3);
		border: var(--stroke-hairline) dashed var(--rule-strong);
		border-radius: 999px;
		color: var(--ink);
		text-decoration: none;
	}
	a:hover {
		border-style: solid;
	}
	a[aria-current="page"] {
		border: var(--stroke-hairline) solid var(--ink);
		background: var(--ink);
		color: var(--ink-inverse);
	}
	a:focus-visible {
		outline: none;
		box-shadow:
			0 0 0 2px var(--paper),
			0 0 0 4px var(--focus);
	}
	@media (pointer: coarse) {
		a {
			min-block-size: 44px;
		}
	}
</style>
