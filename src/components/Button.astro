---
/*
 * Button — starts an action. One primary or accent per view.
 * Guidelines: design-system/components/Button/README.md
 *
 *   <Button variant="accent">Send to editor</Button>
 *   <Button href="/start" size="lg">Start a draft</Button>   (renders an <a>)
 *   <Button variant="secondary"><svg slot="icon" …/>Export</Button>
 */
import type { HTMLAttributes } from "astro/types";

interface Common {
	/** primary = ink fill · accent = marker-blue, the one move forward · secondary = outlined · quiet = text only. */
	variant?: "primary" | "accent" | "secondary" | "quiet";
	/** sm in margin notes and toolbars, lg only for marketing. */
	size?: "sm" | "md" | "lg";
}

type Props = Common &
	(({ href: string } & HTMLAttributes<"a">) | ({ href?: undefined } & HTMLAttributes<"button">));

const { variant = "primary", size = "md", class: className, ...rest } = Astro.props;
const Tag = rest.href ? "a" : "button";
const attrs = Tag === "button" ? { type: "button", ...rest } : rest;
---

<Tag {...attrs} class:list={["sd-btn", `sd-btn--${variant}`, `sd-btn--${size}`, className]}>
	{
		Astro.slots.has("icon") && (
			<span class="sd-btn__icon" aria-hidden="true">
				<slot name="icon" />
			</span>
		)
	}
	<span class="sd-btn__label"><slot /></span>
</Tag>

<style>
	.sd-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-2);
		font-family: var(--font-display);
		font-size: 15px;
		line-height: 20px;
		font-weight: 600;
		letter-spacing: 0.04em;
		padding: 10px var(--space-4) 8px; /* Josefin rides high: +2px on top */
		border: var(--stroke-hairline) solid transparent;
		border-radius: var(--radius-md);
		cursor: pointer;
		text-decoration: none;
		white-space: nowrap;
		transition:
			background-color 120ms,
			opacity 120ms;
	}
	.sd-btn:focus-visible {
		outline: none;
		box-shadow:
			0 0 0 2px var(--paper),
			0 0 0 4px var(--focus);
	}
	.sd-btn:disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}
	.sd-btn--sm {
		font-size: 13px;
		line-height: 16px;
		padding: 7px var(--space-3) 5px;
	}
	.sd-btn--lg {
		font-size: 17px;
		line-height: 24px;
		padding: 13px var(--space-6) 11px;
	}
	.sd-btn__icon {
		display: inline-flex;
		width: 18px;
		height: 18px;
		margin-top: -2px;
	}
	.sd-btn__icon :global(svg) {
		width: 100%;
		height: 100%;
	}

	.sd-btn--primary {
		background: var(--ink);
		color: var(--ink-inverse);
	}
	.sd-btn--accent {
		background: var(--marker-blue);
		color: var(--on-blue);
	}
	.sd-btn--primary:not(:disabled):hover {
		box-shadow: inset 0 0 0 999px rgba(0, 0, 0, 0.14);
	}
	.sd-btn--primary:not(:disabled):hover:focus-visible {
		box-shadow:
			inset 0 0 0 999px rgba(0, 0, 0, 0.14),
			0 0 0 2px var(--paper),
			0 0 0 4px var(--focus);
	}
	/* blue hover moves toward ink: darker in Paper, lighter in Night shift, so on-blue keeps ≥5:1 */
	.sd-btn--accent:not(:disabled):hover {
		box-shadow: inset 0 0 0 999px color-mix(in srgb, var(--ink) 14%, transparent);
	}
	.sd-btn--accent:not(:disabled):hover:focus-visible {
		box-shadow:
			inset 0 0 0 999px color-mix(in srgb, var(--ink) 14%, transparent),
			0 0 0 2px var(--paper),
			0 0 0 4px var(--focus);
	}
	.sd-btn--secondary {
		background: var(--paper-raised);
		color: var(--ink);
		border-color: var(--rule-strong);
	}
	.sd-btn--secondary:not(:disabled):hover {
		background: var(--paper-sunken);
	}
	.sd-btn--quiet {
		background: transparent;
		color: var(--ink);
		padding-left: var(--space-2);
		padding-right: var(--space-2);
	}
	/* Josefin rides high: lift the highlight so caps and baseline sit centred */
	.sd-btn--quiet:not(:disabled):hover .sd-btn__label {
		background: var(--marker-yellow);
		color: var(--on-marker);
		border-radius: var(--radius-sm);
		box-shadow: 0 -0.14em 0 3px var(--marker-yellow);
	}
</style>
