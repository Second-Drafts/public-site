---
/* Render at body level: a modal inside an inert subtree can't be used. */
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"dialog"> {
	width?: string;
}

const { width = "26rem", class: className, style, ...rest } = Astro.props;
---

<dialog {...rest} class:list={["sd-dialog", className]} style={`--sd-dialog-width: ${width}; ${style ?? ""}`}>
	<div class="sd-dialog__panel">
		<slot />
	</div>
</dialog>

<style>
	.sd-dialog {
		inline-size: min(var(--sd-dialog-width), 100% - 2 * var(--space-6));
		padding: 0;
		color: var(--ink);
		background: var(--paper-raised);
		border: var(--stroke-hairline) solid var(--rule);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lift);
		opacity: 0;
	}
	.sd-dialog[open] {
		opacity: 1;
	}
	.sd-dialog::backdrop {
		background: oklch(0% 0 none / 0.4);
		opacity: 0;
	}
	.sd-dialog[open]::backdrop {
		opacity: 1;
	}
	@starting-style {
		.sd-dialog[open],
		.sd-dialog[open]::backdrop {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: no-preference) {
		.sd-dialog,
		.sd-dialog::backdrop {
			transition:
				opacity 200ms var(--ease-out, ease-out),
				display 200ms allow-discrete,
				overlay 200ms allow-discrete;
		}
	}
	.sd-dialog__panel {
		display: grid;
		gap: var(--space-4);
		padding: var(--space-6);
	}

	:global(.sd-dialog__title) {
		margin: 0;
	}
	:global(.sd-dialog__text) {
		margin: 0;
		font-family: var(--font-prose);
		font-size: 17px;
		line-height: 28px;
	}
	:global(.sd-dialog__actions) {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
</style>
