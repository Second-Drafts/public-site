---
import Link from "../../../components/Link.astro";
import PageHeader from "../../../components/PageHeader.astro";
import Base from "../../../layouts/Base.astro";
import { getPublishedCategories } from "../../../lib/blog";
import { CATEGORIES, categoryPath } from "../../../lib/blog-taxonomy";

const description = "Everything the Department's blog covers, by category.";
---

<Base title="Categories" pageType="CollectionPage" description={description}>
	<PageHeader title="Categories">What the Department writes about.</PageHeader>

	<ul class="categories">
		{
			(await getPublishedCategories()).map((category) => (
				<li>
					<Link href={categoryPath(category)} class="sd-text-heading">
						{CATEGORIES[category].label}
					</Link>
					<p>{CATEGORIES[category].description}</p>
				</li>
			))
		}
	</ul>
</Base>

<style>
	.categories {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	p {
		margin: var(--space-2) 0 0;
		color: var(--ink-muted);
	}
</style>
