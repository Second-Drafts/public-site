---
import BlogListing from "../../../components/BlogListing.astro";
import Base from "../../../layouts/Base.astro";
import { categoryListing, getFilteredPosts } from "../../../lib/blog";
import { CATEGORY_KEYS, type CategoryKey } from "../../../lib/blog-taxonomy";
import { blog } from "../../../lib/seo/schema";

export function getStaticPaths() {
	return CATEGORY_KEYS.map((category) => ({ params: { category }, props: { category } }));
}

interface Props {
	category: CategoryKey;
}

const { category } = Astro.props;
const { title, description } = categoryListing(category);
const posts = await getFilteredPosts({ category });
---

<Base title={title} pageType="CollectionPage" description={description} noindex={posts.length === 0} schema={[blog()]}>
	<BlogListing posts={posts} category={category} />
</Base>
