---
import BlogListing from "../../../components/BlogListing.astro";
import Base from "../../../layouts/Base.astro";
import { deskListing, getFilteredPosts } from "../../../lib/blog";
import { DESK_KEYS, type DeskKey } from "../../../lib/blog-taxonomy";
import { blog } from "../../../lib/seo/schema";

export function getStaticPaths() {
	return DESK_KEYS.map((desk) => ({ params: { desk }, props: { desk } }));
}

interface Props {
	desk: DeskKey;
}

const { desk } = Astro.props;
const { title, description } = deskListing(desk);
const posts = await getFilteredPosts({ desk });
---

<Base title={title} pageType="CollectionPage" description={description} noindex={posts.length === 0} schema={[blog()]}>
	<BlogListing posts={posts} desk={desk} />
</Base>
