---
import TextField from "../../components/TextField.astro";
import Base from "../../layouts/Base.astro";
---

<Base title="Word Counter">
  <h1 class="sd-text-headline">Word Counter</h1>
  <p class="lede">
    Type or paste some text to quickly check its word or character count
  </p>
  <TextField id="input" label="Your text" multiline rows={10} />
  <p class="count">
    <span id="count">0</span><span
      id="denominator-display"
      style="display: none;">/<span id="target-display">0</span></span
    >&nbsp;
    <span id="unit-display">words</span>
  </p>
  <fieldset class="targets">
    <legend class="sd-text-label">Targets</legend>
    <!-- Show target toggle -->
    <label class="check" for="show-target">
      <input type="checkbox" id="show-target" />
      Show target
    </label>
    <!-- Dropdown for unit (words, characters) -->
    <div class="select">
      <label class="sd-text-label" for="unit">Unit</label>
      <!-- default is words -->
      <select id="unit">
        <option value="characters">Characters</option>
        <option value="words" selected>Words</option>
      </select>
    </div>

    <!-- Input for target value -->
    <TextField id="target" label="Target" type="number" value="240" min="0" />

    <!-- Style (min, max, goal) -->
    <div class="select">
      <label class="sd-text-label" for="style">Style</label>
      <select id="style">
        <option value="min">Min</option>
        <option value="max">Max</option>
        <option value="goal">Goal</option>
      </select>
    </div>
  </fieldset>
</Base>

<style>
  h1 {
    margin: 0 0 var(--space-2);
    font-weight: 600;
  }
  .lede {
    margin: 0 0 var(--space-8);
    color: var(--ink-muted);
  }
  /* numbers about writing are set in mono */
  .count {
    margin: var(--space-4) 0 var(--space-8);
    font-family: var(--font-mono);
    font-size: 20px;
    line-height: 28px;
    font-weight: 500;
  }
  .targets {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: var(--space-4) var(--space-6) var(--space-6);
    border: var(--stroke-hairline) solid var(--rule);
    border-radius: var(--radius-md);
    background: var(--paper-raised);
  }
  .targets legend {
    padding: 0 var(--space-2);
  }
  .check {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .check input {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--marker-blue);
  }
  .select {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  /* matches TextField's input */
  select {
    font-family: var(--font-prose);
    font-size: 17px;
    line-height: 28px;
    color: var(--ink);
    background: var(--paper-raised);
    border: var(--stroke-hairline) solid var(--rule-strong);
    border-radius: var(--radius-sm);
    padding: 6px var(--space-3);
  }
  select:focus-visible,
  .check input:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px var(--paper),
      0 0 0 4px var(--focus);
  }
</style>

<script>
  const querySelector = <T extends HTMLElement>(selector: string): T => {
    const element = document.querySelector<T>(selector);
    if (!element) {
      throw new Error(`Element with selector ${selector} not found`);
    }
    return element;
  };
  const input = querySelector<HTMLTextAreaElement>("#input");
  const count = querySelector<HTMLElement>("#count");
  const target = querySelector<HTMLInputElement>("#target");
  const targetDisplay = querySelector<HTMLElement>("#target-display");
  const denominatorDisplay = querySelector<HTMLElement>("#denominator-display");
  const unit = querySelector<HTMLSelectElement>("#unit");
  const unitDisplay = querySelector<HTMLElement>("#unit-display");
  const style = querySelector<HTMLSelectElement>("#style");
  const showTarget = querySelector<HTMLInputElement>("#show-target");

  const countWords = (text: string): number =>
    text.split(/\s+/).filter(Boolean).length;

  const countCharacters = (text: string): number => text.length;
  function percentToColor(
    percent: number,
    style: "min" | "max" | "goal"
  ): string {
    // Theme tokens, so the colours hold in Paper and Night shift.
    if (style === "min") {
      return percent < 1 ? "var(--red-pen)" : "var(--green-ink)";
    } else if (style === "max") {
      return percent > 1 ? "var(--red-pen)" : "var(--green-ink)";
    } else if (style === "goal") {
      let distance = Math.abs(percent - 1);
      distance = Math.min(distance, 0.2) / 0.2;
      return `color-mix(in srgb, var(--green-ink) ${Math.round((1 - distance) * 100)}%, var(--ink-muted))`;
    } else {
      throw new Error(`Invalid style: ${style}`);
    }
  }
  function updateDisplay() {
    let countValue = 0;
    if (unit.value === "words") countValue = countWords(input.value);
    else if (unit.value === "characters")
      countValue = countCharacters(input.value);
    else throw new Error(`Invalid unit: ${unit.value}`);
    unitDisplay.textContent = unit.value;
    denominatorDisplay.style.display = showTarget.checked ? "inline" : "none";
    targetDisplay.textContent = String(Number(target.value));
    count.textContent = String(countValue);
    count.style.color = percentToColor(
      countValue / Number(target.value),
      style.value as "min" | "max" | "goal"
    );
  }

  input.addEventListener("input", updateDisplay);
  target.addEventListener("change", updateDisplay);
  unit.addEventListener("change", updateDisplay);
  style.addEventListener("change", updateDisplay);
  showTarget.addEventListener("change", updateDisplay);
</script>
