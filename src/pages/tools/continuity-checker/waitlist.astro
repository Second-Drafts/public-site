---
import Link from "../../../components/Link.astro";
import Mark from "../../../components/Mark.astro";
import Base from "../../../layouts/Base.astro";
import WaitlistForm from "../../../tools/continuity-checker/WaitlistForm.astro";
---

<Base
	title="Continuity Checker waitlist"
	description="Join the waitlist for the Continuity Checker, and tell us about the book you'd check with it."
>
	<div class="ccw-page">
		<p class="ccw-page__back"><Link href="/tools/continuity-checker/">Continuity Checker</Link></p>
		<h1 class="sd-text-headline ccw-page__headline">Join the <Mark>waitlist</Mark></h1>
		<p class="ccw-page__lede">
			Leave your email and we’ll tell you when the Continuity Checker launches.
		</p>
		<WaitlistForm />
	</div>
</Base>

<style>
	.ccw-page {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		padding-block: var(--space-12) var(--space-16);
	}
	.ccw-page p,
	.ccw-page h1 {
		margin: 0;
	}
	.ccw-page__back {
		font-size: 15px;
		line-height: 22px;
	}
	.ccw-page__headline {
		font-weight: 600;
		text-wrap: balance;
	}
	.ccw-page__lede {
		margin-block-end: var(--space-4);
		color: var(--ink-muted);
		text-wrap: pretty;
	}
</style>
