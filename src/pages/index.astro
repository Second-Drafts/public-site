---
import Logo from "../components/Logo.astro";
import Base from "../layouts/Base.astro";
// This is server-side code. This will log in the terminal, not the browser console.
console.log("Homepage loaded");
---

<Base>
	<h1 class="masthead">
		<Logo width={360} />
	</h1>
	<p>
		Welcome! You're one of the very first to have found us. We promise there's much more to come for storytellers of
		all types.
	</p>
	<p class="signature">– The Department</p>
</Base>

<style>
	.masthead {
		display: flex;
		justify-content: center;
		margin: 0 0 var(--space-8);
	}
	p {
		margin: 0 0 var(--space-6);
		text-wrap: pretty;
		font-size: 20px;
		line-height: 32px;
	}
	.signature {
		text-align: right;
		font-style: italic;
	}
</style>
