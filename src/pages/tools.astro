---
import Link from "../components/Link.astro";
import PageHeader from "../components/PageHeader.astro";
import Base from "../layouts/Base.astro";

const tools = {
	"word-counter": {
		title: "Word Counter",
		description: "Count words and characters, check a limit for an essay, story or post, and see how long your text takes to read aloud. Your text stays in your browser.",
	},
	"writing-sprint": {
		title: "Writing Sprint",
		description: "Set a timer for 10, 15, 25 minutes or your own, write without stopping, and see how many words you got down. Your draft stays in your browser.",
	},
	"draft-analysis": {
		title: "Draft Analysis",
		description: "See the length of every sentence at a glance, with long ones flagged. Your draft stays in your browser.",
	},
	teleprompter: {
		title: "Teleprompter",
		description: "Read your script from the screen. Free, with no account and no time limits, in fonts and colours that are easy on the eyes.",
	},
	"magic-8-ball": {
		title: "Magic 8 Ball",
		description: "Ask a question, then click, drag or shake your phone for an answer. Classic answers or a deck for writers. Your question stays in your browser.",
	},
};
---

<Base title="Tools">
	<PageHeader title="Tools">Our collection of free writing tools</PageHeader>

	<ul class="tools">
		{
			Object.entries(tools).map(([key, tool]) => (
				<li>
					<Link href={`/tools/${key}`} class="sd-text-heading">
						{tool.title}
					</Link>
					<p>{tool.description}</p>
				</li>
			))
		}
	</ul>
</Base>

<style>
	.tools {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.tools p {
		margin: var(--space-2) 0 0;
		color: var(--ink-muted);
	}
</style>
