---
import Link from "../components/Link.astro";
import PageHeader from "../components/PageHeader.astro";
import Base from "../layouts/Base.astro";

const tools = {
	"word-counter": {
		title: "Word Counter",
		description: "A simple tool to count words in your text.",
	},
};
---

<Base title="Tools">
	<PageHeader title="Tools">Our collection of free writing tools</PageHeader>

	<ul class="tools">
		{
			Object.entries(tools).map(([key, tool]) => (
				<li>
					<Link href={`/tools/${key}`} class="sd-text-heading">
						{tool.title}
					</Link>
					<p>{tool.description}</p>
				</li>
			))
		}
	</ul>
</Base>

<style>
	.tools {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.tools p {
		margin: var(--space-2) 0 0;
		color: var(--ink-muted);
	}
</style>
