---
import ScaleField from "../../components/ScaleField.astro";
import { Content } from "../../../brand/foundation/components/ScaleField/README.md";
import Guidelines from "./_components/Guidelines.astro";
import SandboxLayout from "./_components/SandboxLayout.astro";
import Specimen from "./_components/Specimen.astro";
import ThemePanel from "./_components/ThemePanel.astro";
import { THEMES } from "./_components/themes";
---

<SandboxLayout title="ScaleField" description="A question answered from 1 to 5, with words for both ends.">
	<Guidelines source="brand/foundation/components/ScaleField/README.md"><Content /></Guidelines>

	<Specimen title="States" description="Pick a step for the ink fill; tab in for the focus ring.">
		{
			THEMES.map((theme) => (
				<ThemePanel theme={theme} layout="stack">
					<ScaleField
						label="How do you feel about sending your manuscript to an AI service?"
						name={`comfort-${theme}`}
						low="Not at all comfortable"
						high="Completely comfortable"
					/>
				</ThemePanel>
			))
		}
	</Specimen>
</SandboxLayout>
