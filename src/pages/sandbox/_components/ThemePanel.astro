---
/*
 * One theme's ground for a specimen. Render it once per theme from the page:
 *   {THEMES.map((theme) => <ThemePanel theme={theme}>…</ThemePanel>)}
 * so each panel gets its own render (and its own TextField ids).
 */
import { THEME_NAMES, type Theme } from "./themes";

interface Props {
	theme: Theme;
	/** row = wrap inline items · stack = one under another */
	layout?: "row" | "stack";
}

const { theme, layout = "row" } = Astro.props;
---

<div data-theme={theme} class="sb-panel">
	<p class="sb-panel__name sd-text-meta">{THEME_NAMES[theme]}</p>
	<div class:list={["sb-panel__body", `sb-panel__body--${layout}`]}>
		<slot />
	</div>
</div>

<style>
	.sb-panel {
		min-width: 0;
		padding: var(--space-4) var(--space-6) var(--space-6);
		background: var(--paper);
		color: var(--ink);
		border: var(--stroke-hairline) solid var(--rule);
	}
	.sb-panel__name {
		margin: 0 0 var(--space-4);
		color: var(--ink-muted);
	}
	.sb-panel__body {
		display: flex;
		gap: var(--space-3);
	}
	.sb-panel__body--row {
		flex-wrap: wrap;
		align-items: center;
	}
	.sb-panel__body--stack {
		flex-direction: column;
		align-items: stretch;
		gap: var(--space-6);
	}
</style>
