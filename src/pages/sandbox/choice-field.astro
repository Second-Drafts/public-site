---
import ChoiceField from "../../components/ChoiceField.astro";
import { Content } from "../../../design-system/components/ChoiceField/README.md";
import Guidelines from "./_components/Guidelines.astro";
import SandboxLayout from "./_components/SandboxLayout.astro";
import Specimen from "./_components/Specimen.astro";
import ThemePanel from "./_components/ThemePanel.astro";
import { THEMES } from "./_components/themes";

const stages = [
	{ value: "first_draft", label: "First draft" },
	{ value: "revising", label: "Revising" },
	{ value: "readers_soon", label: "Going to readers, an agent or an editor soon" },
	{ value: "published", label: "Published" },
];

const tools = [
	{ value: "word", label: "Word" },
	{ value: "google_docs", label: "Google Docs" },
	{ value: "scrivener", label: "Scrivener" },
	{ value: "plain_text", label: "Markdown or plain text" },
];
---

<SandboxLayout title="ChoiceField" description="A question answered with radio buttons, or checkboxes when several fit.">
	<Guidelines source="design-system/components/ChoiceField/README.md"><Content /></Guidelines>

	<Specimen title="One answer" description="Radio buttons. The options wrap into columns when there's room.">
		{
			THEMES.map((theme) => (
				<ThemePanel theme={theme} layout="stack">
					<ChoiceField label="Where is it now?" name={`stage-${theme}`} options={stages} />
				</ThemePanel>
			))
		}
	</Specimen>

	<Specimen
		title="Several answers"
		description="multiple renders checkboxes; the hint sits under the question. Pick Something else to reveal its field."
	>
		{
			THEMES.filter((theme) => theme !== "highlighted").map((theme) => (
				<ThemePanel theme={theme} layout="stack">
					<ChoiceField
						label="What do you write in?"
						name={`tools-${theme}`}
						multiple
						hint="Pick all that apply."
						options={tools}
						other={{ label: "Something else", detail: "Which app?" }}
					/>
				</ThemePanel>
			))
		}
	</Specimen>
</SandboxLayout>
