---
import Link from "../components/Link.astro";
import PostMeta from "../components/PostMeta.astro";
import { type CategoryKey, DESKS, type DeskKey, deskAboutPath } from "../lib/blog-taxonomy";
import { blogPosting } from "../lib/seo/schema";
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  author: DeskKey;
  category: CategoryKey;
}

const { title, description, date, updated, author, category } = Astro.props;
const desk = DESKS[author];
---

<Base
  title={title}
  description={description}
  article={{ publishedTime: date }}
  dateModified={updated}
  schema={blogPosting({ datePublished: date, dateModified: updated, author, category })}
>
  <article>
    <h1 class="sd-text-headline">{title}</h1>
    <PostMeta author={author} category={category} date={date} updated={updated} />
    <div class="prose">
      <slot />
    </div>
    <footer class="desk-note">
      <p>
        <strong>{desk.name}.</strong> {desk.description}{" "}
        <Link href={deskAboutPath(author)}>About the desks</Link>
      </p>
    </footer>
  </article>
</Base>

<style>
  h1 {
    margin: 0 0 var(--space-2);
    font-weight: 600;
  }
  .prose {
    margin-block-start: var(--space-8);
  }
  .desk-note {
    margin-block-start: var(--space-12);
    padding-block-start: var(--space-4);
    border-block-start: var(--stroke-hairline) solid var(--rule-strong);
    color: var(--ink-muted);
  }
  .desk-note p {
    margin: 0;
    text-wrap: pretty;
  }
  .desk-note strong {
    color: var(--ink);
    font-weight: 600;
  }
  /* Rendered markdown has no classes, so style it from the wrapper. */
  .prose :global(h2),
  .prose :global(h3) {
    margin: var(--space-8) 0 var(--space-2);
    font-weight: 600;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--space-4);
  }
  .prose :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--marker-green);
    text-decoration-thickness: 0.125em;
    text-underline-offset: 0.125em;
  }
  .prose :global(blockquote) {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-4);
    border-left: var(--stroke-hairline) solid var(--rule-strong);
    color: var(--ink-muted);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
  }
</style>
