---
import { formatDate } from "../lib/blog";
import Base from "./Base.astro";

interface Props {
	title: string;
	date: Date;
}

const { title, date } = Astro.props;
---

<Base title={title}>
	<article>
		<h1 class="sd-text-headline">{title}</h1>
		<p class="date">
			<time datetime={date.toISOString()}>{formatDate(date)}</time>
		</p>
		<div class="prose">
			<slot />
		</div>
	</article>
</Base>

<style>
	h1 {
		margin: 0 0 var(--space-2);
		font-weight: 600;
	}
	.date {
		margin: 0 0 var(--space-8);
		color: var(--ink-muted);
	}
	/* Rendered markdown has no classes, so style it from the wrapper. */
	.prose :global(h2),
	.prose :global(h3) {
		margin: var(--space-8) 0 var(--space-2);
		font-weight: 600;
	}
	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 var(--space-4);
	}
	.prose :global(a) {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: var(--marker-green);
		text-decoration-thickness: 3px;
		text-underline-offset: 3px;
	}
	.prose :global(blockquote) {
		margin: 0 0 var(--space-4);
		padding-left: var(--space-4);
		border-left: var(--stroke-hairline) solid var(--rule-strong);
		color: var(--ink-muted);
	}
	.prose :global(code) {
		font-family: var(--font-mono);
	}
</style>
