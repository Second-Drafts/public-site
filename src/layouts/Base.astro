---
import DesignSystemHead from "../components/DesignSystemHead.astro";

interface Props {
	title?: string;
}

const { title } = Astro.props;
const siteName = "The Department of Second Drafts";
const fullTitle = title ? `${siteName}: ${title}` : siteName;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="light dark" />
		<title>{fullTitle}</title>
		<!-- No data-theme here: the reader's system setting picks Paper or Night shift (see DesignSystemHead). -->
		<DesignSystemHead />
	</head>
	<body>
		<main class="page">
			<slot />
		</main>
	</body>
</html>

<style>
	.page {
		max-width: 34em;
		margin: 0 auto;
		padding: var(--space-16) var(--space-6);
	}
</style>
