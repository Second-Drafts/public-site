---
import { WORDS_PER_MINUTE } from "../../lib/text/measure";
import { INITIAL_STATE, summarize } from "./lib/state";

const { count } = summarize(INITIAL_STATE);
---

<div class="wc-count-line" id="wc-count-line">
	<p class="wc-count"><span id="wc-count">{count}</span> <span id="wc-status" class="wc-status"></span></p>
	<p class="wc-extras">
		<span id="wc-speaking" class="wc-speaking" title={`At ${WORDS_PER_MINUTE} words per minute`} hidden></span>
		<a id="wc-open-teleprompter" class="wc-open-teleprompter" href="/tools/teleprompter" hidden>Open in Teleprompter</a>
	</p>
	<p id="wc-announcement" class="sd-visually-hidden" aria-live="polite"></p>
</div>

<style>
	.wc-count-line {
		margin: var(--space-4) 0 var(--space-8);
	}
	/* numbers about writing are set in mono */
	.wc-count {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		column-gap: var(--space-3);
		font-family: var(--font-mono);
		font-size: 20px;
		line-height: 28px;
		font-weight: 500;
		color: var(--ink);
	}
	.wc-status {
		font-family: var(--font-prose);
		font-size: 17px;
		font-weight: 400;
		color: var(--ink-muted);
	}
	.wc-extras {
		margin: var(--space-1) 0 0;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		column-gap: var(--space-3);
		font-family: var(--font-prose);
		font-size: 17px;
		line-height: 28px;
		color: var(--ink-muted);
	}
	.wc-speaking[hidden] {
		display: none;
	}
	.wc-open-teleprompter {
		margin-inline-start: auto;
		color: var(--ink-muted);
		text-decoration: underline var(--stroke-hairline) var(--rule-strong);
		text-underline-offset: 4px;
	}
	.wc-open-teleprompter[hidden] {
		display: none;
	}
	@media (hover: hover) and (pointer: fine) {
		.wc-open-teleprompter:hover {
			color: var(--ink);
		}
	}
	.wc-count-line[data-state="met"] #wc-count {
		color: var(--green-ink);
	}
	.wc-count-line[data-state="over"] #wc-count {
		color: var(--red-pen);
	}
</style>
