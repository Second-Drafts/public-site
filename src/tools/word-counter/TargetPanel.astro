---
import TextField from "../../components/TextField.astro";
import type { Unit } from "../../lib/text/measure";
import { DEFAULT_TARGET } from "./lib/state";
import { NO_PRESET, presetGroups } from "./lib/presets";
import { CUSTOM_PRESET } from "./lib/settings";
import { RULES, UNITS, type Rule } from "./lib/target";

const RULE_LABELS: Record<Rule, string> = {
	"at-most": "At most",
	"at-least": "At least",
	exactly: "Exactly",
	around: "Around",
};
const UNIT_LABELS: Record<Unit, string> = {
	words: "Words",
	characters: "Characters",
	seconds: "Seconds aloud",
};
---

<fieldset class="wc-targets">
	<legend class="sd-text-label">Target</legend>
	<label class="wc-check" for="wc-show-target">
		<input type="checkbox" id="wc-show-target" />
		Show target
	</label>
	<div class="wc-select wc-preset">
		<label class="sd-text-label" for="wc-preset">Format</label>
		<select id="wc-preset">
			<option value={NO_PRESET}>None</option>
			{
				presetGroups().map((group) => (
					<optgroup label={group.name}>
						{group.presets.map((preset) => <option value={preset.id}>{preset.name}</option>)}
					</optgroup>
				))
			}
			<option value={CUSTOM_PRESET} selected>Custom</option>
		</select>
		<p class="wc-preset-description" id="wc-preset-description" aria-live="polite"></p>
	</div>
	<div class="wc-select">
		<label class="sd-text-label" for="wc-rule">Rule</label>
		<select id="wc-rule">
			{RULES.map((rule) => <option value={rule} selected={rule === DEFAULT_TARGET.rule}>{RULE_LABELS[rule]}</option>)}
		</select>
	</div>
	<TextField id="wc-target" label="Target" type="number" inputmode="numeric" min="1" value={String(DEFAULT_TARGET.value)} />
	<div class="wc-select">
		<label class="sd-text-label" for="wc-unit">Unit</label>
		<select id="wc-unit">
			{UNITS.map((unit) => <option value={unit} selected={unit === DEFAULT_TARGET.unit}>{UNIT_LABELS[unit]}</option>)}
		</select>
	</div>
</fieldset>

<style>
	.wc-targets {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
		gap: var(--space-6);
		margin: 0;
		padding: var(--space-4) var(--space-6) var(--space-6);
		border: var(--stroke-hairline) solid var(--rule);
		border-radius: var(--radius-md);
		background: var(--paper-raised);
	}
	.wc-targets legend {
		padding: 0 var(--space-2);
	}
	.wc-check {
		grid-column: 1 / -1;
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}
	.wc-check input {
		width: 18px;
		height: 18px;
		margin: 0;
		accent-color: var(--marker-blue);
	}
	.wc-preset {
		grid-column: 1 / -1;
	}
	.wc-preset-description {
		margin: 0;
		min-height: 1lh;
		color: var(--ink-muted);
	}
	.wc-select {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}
	/* matches TextField's input; the drawn chevron keeps the same inset as the text, which the native arrow doesn't */
	select {
		appearance: none;
		font-family: var(--font-prose);
		font-size: 17px;
		line-height: 28px;
		color: var(--ink);
		background-color: var(--paper-raised);
		background-image:
			linear-gradient(45deg, transparent 50%, var(--ink-muted) 50%),
			linear-gradient(135deg, var(--ink-muted) 50%, transparent 50%);
		background-position:
			right calc(var(--space-3) + 5px) center,
			right var(--space-3) center;
		background-size: 5px 5px;
		background-repeat: no-repeat;
		border: var(--stroke-hairline) solid var(--rule-strong);
		border-radius: var(--radius-sm);
		padding-block: 6px;
		padding-inline: var(--space-3) calc(var(--space-3) * 2 + 10px);
	}
	@media (forced-colors: active) {
		select {
			appearance: auto;
			background-image: none;
		}
	}
	select:focus-visible,
	.wc-check input:focus-visible {
		outline: none;
		box-shadow:
			0 0 0 2px var(--paper),
			0 0 0 4px var(--focus);
	}
</style>
