---
import { presetGroups } from "./lib/presets";
---

<div class="wc-target-drawer" id="wc-target-drawer" hidden>
	<p class="wc-sentence">
		<span>Aim for</span>
		<select class="wc-blank" id="wc-rule" aria-label="Limit">
			<option value="at-most">at most</option>
			<option value="at-least">at least</option>
			<option value="exactly">exactly</option>
			<option value="around">around</option>
			<option value="between">between</option>
		</select>
		<span class="wc-range" id="wc-range" hidden>
			<input class="wc-blank wc-number" id="wc-min" type="number" inputmode="decimal" min="0" step="any" aria-label="Minimum" />
			<span>and</span>
		</span>
		<input class="wc-blank wc-number" id="wc-target" type="number" inputmode="decimal" min="0" step="any" aria-label="Target" />
		<select class="wc-blank" id="wc-unit" aria-label="Unit">
			<option value="words">words</option>
			<option value="characters">characters</option>
			<option value="seconds">minutes aloud</option>
		</select>
	</p>
	<div class="wc-formats" role="group" aria-label="Formats">
		{
			presetGroups().map((group) => (
				<div class="wc-format-row">
					<span class="sd-text-label">{group.name}</span>
					<span class="wc-format-list">
						{group.presets.map((preset) => (
							<button type="button" class="wc-format" data-preset={preset.id} aria-pressed="false">
								{preset.name}
							</button>
						))}
					</span>
				</div>
			))
		}
	</div>
	<p class="wc-format-description" id="wc-preset-description"></p>
</div>

<style>
	.wc-target-drawer {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		margin: calc(-1 * var(--space-4)) 0 var(--space-8);
		padding: var(--space-6);
		background: var(--paper-raised);
		border: var(--stroke-hairline) solid var(--rule);
		border-radius: var(--radius-md);
	}
	.wc-target-drawer[hidden] {
		display: none;
	}
	p {
		margin: 0;
	}

	/* the target as one sentence with blanks to fill in */
	.wc-sentence {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-2);
		font-family: var(--font-prose);
		font-size: 22px;
		line-height: 36px;
		color: var(--ink);
	}
	.wc-range {
		display: inline-flex;
		align-items: baseline;
		gap: var(--space-2);
	}
	.wc-range[hidden] {
		display: none;
	}
	.wc-blank {
		field-sizing: content;
		appearance: none;
		font: inherit;
		color: var(--ink);
		background: transparent;
		border: 0;
		border-block-end: var(--stroke-pen) solid var(--rule-strong);
		border-radius: 0;
		padding: 0 var(--space-1);
	}
	select.wc-blank {
		padding-inline-end: calc(var(--space-1) + 16px);
		background-image:
			linear-gradient(45deg, transparent 50%, var(--ink-muted) 50%),
			linear-gradient(135deg, var(--ink-muted) 50%, transparent 50%);
		background-position:
			right calc(var(--space-1) + 5px) center,
			right var(--space-1) center;
		background-size: 5px 5px;
		background-repeat: no-repeat;
		cursor: pointer;
	}
	.wc-number {
		min-inline-size: 3ch;
		inline-size: 4.5ch;
		text-align: center;
		appearance: textfield;
	}
	.wc-number::-webkit-inner-spin-button,
	.wc-number::-webkit-outer-spin-button {
		appearance: none;
		margin: 0;
	}
	.wc-blank:focus-visible {
		outline: none;
		border-color: var(--focus);
		box-shadow: 0 1px 0 var(--focus);
	}
	@media (forced-colors: active) {
		select.wc-blank {
			appearance: auto;
			background-image: none;
		}
	}

	/* formats fill the sentence in */
	.wc-formats {
		display: grid;
		gap: var(--space-2);
	}
	.wc-format-row {
		display: grid;
		grid-template-columns: 7.5rem 1fr;
		align-items: baseline;
		gap: var(--space-3);
	}
	.wc-format-list {
		display: flex;
		flex-wrap: wrap;
		column-gap: var(--space-4);
		row-gap: var(--space-1);
	}
	.wc-format {
		all: unset;
		cursor: pointer;
		font-family: var(--font-prose);
		font-size: 15px;
		line-height: 24px;
		color: var(--ink);
		text-decoration: underline var(--stroke-hairline) var(--rule-strong);
		text-underline-offset: 4px;
	}
	.wc-format[aria-pressed="true"] {
		text-decoration: underline 3px var(--marker-blue);
	}
	.wc-format:focus-visible {
		outline: none;
		border-radius: var(--radius-sm);
		box-shadow:
			0 0 0 2px var(--paper),
			0 0 0 4px var(--focus);
	}
	@media (hover: hover) and (pointer: fine) {
		.wc-format:hover {
			text-decoration-color: var(--ink);
		}
	}
	.wc-format-description {
		min-height: 24px;
		font-family: var(--font-prose);
		font-size: 15px;
		line-height: 24px;
		color: var(--ink-muted);
	}
	@media (max-width: 30rem) {
		.wc-target-drawer {
			padding: var(--space-4);
		}
		.wc-format-row {
			grid-template-columns: 1fr;
			gap: var(--space-1);
		}
		.wc-sentence {
			font-size: 19px;
		}
	}
</style>
