---
import Button from "../../components/Button.astro";
---

<span class="wc-target-actions">
	<Button variant="quiet" size="sm" id="wc-target-toggle" aria-expanded="false" aria-controls="wc-target-drawer">
		Set a target
	</Button>
	<Button variant="quiet" size="sm" id="wc-target-remove" hidden>Remove</Button>
</span>

<style>
	.wc-target-actions {
		display: inline-flex;
		gap: var(--space-1);
		align-self: center;
	}
	.wc-target-actions :global([hidden]) {
		display: none;
	}
</style>
