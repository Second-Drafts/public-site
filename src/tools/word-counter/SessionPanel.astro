---
import Button from "../../components/Button.astro";
import TextField from "../../components/TextField.astro";
import { MAX_SPRINT_MINUTES, SPRINT_PRESET_MINUTES } from "./lib/sprint";
---

<section class="wc-session" aria-label="Session and sprints">
	<p id="wc-session-progress" class="wc-session-progress"></p>

	<div id="wc-sprint-setup" class="wc-sprint-setup">
		<p class="sd-text-label">Start a sprint</p>
		<div class="wc-sprint-choices">
			{
				SPRINT_PRESET_MINUTES.map((minutes) => (
					<Button variant="secondary" size="sm" data-sprint-minutes={minutes}>
						{minutes} min
					</Button>
				))
			}
			<TextField
				id="wc-sprint-custom"
				label="Custom minutes"
				type="number"
				inputmode="numeric"
				min="1"
				max={MAX_SPRINT_MINUTES}
			/>
			<Button id="wc-sprint-custom-start" variant="secondary" size="sm">Start</Button>
		</div>
	</div>

	<div id="wc-sprint-running" class="wc-sprint-running" hidden>
		<p class="wc-sprint-readout" role="timer">
			<span id="wc-sprint-clock"></span> left <span aria-hidden="true">&middot;</span>{" "}
			<span id="wc-sprint-words"></span>
		</p>
		<div class="wc-sprint-track" aria-hidden="true"><div id="wc-sprint-bar" class="wc-sprint-bar"></div></div>
		<Button id="wc-sprint-stop" variant="quiet" size="sm">Stop sprint</Button>
	</div>

	<p id="wc-sprint-summary" class="wc-sprint-summary" role="status"></p>
</section>

<style>
	.wc-session {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		margin: var(--space-6) 0 var(--space-8);
	}
	p {
		margin: 0;
	}
	.wc-session-progress,
	.wc-sprint-readout,
	.wc-sprint-summary {
		font-family: var(--font-mono);
		font-size: 17px;
		line-height: 28px;
		color: var(--ink);
	}
	.wc-session-progress {
		color: var(--ink-muted);
	}
	.wc-sprint-setup {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}
	.wc-sprint-choices {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		gap: var(--space-3);
	}
	.wc-sprint-running {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
	}
	.wc-sprint-setup[hidden],
	.wc-sprint-running[hidden] {
		display: none;
	}
	.wc-sprint-track {
		align-self: stretch;
		height: var(--stroke-marker);
		background: var(--paper-sunken);
		border-radius: var(--radius-pill);
		overflow: hidden;
	}
	.wc-sprint-bar {
		height: 100%;
		background: var(--marker-blue);
		transform-origin: left;
		transform: scaleX(var(--elapsed, 0));
	}
	@media (prefers-reduced-motion: no-preference) {
		.wc-sprint-bar {
			transition: transform 1s linear;
		}
	}
</style>
