---
/*
 * SettingsHint: the quiet line under a control. `alt` is the text it shows instead when the control is in
 * its other state (a disabled slider, a forced toggle); settings-panel.ts reads it from data-hint-alt.
 */
interface Props {
	id?: string;
	alt?: string;
}
const { id, alt } = Astro.props;
---

<p class="ctl__hint" {id} data-hint-alt={alt}><slot /></p>

<style is:global>
	.ctl__hint {
		margin: 0;
		font-family: var(--font-prose);
		font-size: 14px;
		line-height: 20px;
		color: var(--ink-muted);
	}
</style>
