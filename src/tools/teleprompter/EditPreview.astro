---
import PromptStage from "./PromptStage.astro";
---

<section class="tpv" aria-label="Preview" data-tp-preview>
	<!-- Hidden from screen readers: the script box already has these words. -->
	<div class="tpv__stage" aria-hidden="true">
		<PromptStage />
	</div>
	<p class="tpv__caption sd-text-meta">
		<span>Preview at actual size</span>
		<span class="tpv__flag" data-tpv="mirror" hidden>Mirrored</span>
		<span class="tpv__flag" data-tpv="flip" hidden>Flipped</span>
	</p>
	<!-- Outside the stage, so mirror and flip never reverse them and screen readers can reach them. -->
	<div class="tpv__actions">
		<button type="button" class="tpv__btn tpv__start" data-tpe="start" disabled>
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z"></path></svg>
			Start prompting
		</button>
		<button type="button" class="tpv__btn tpv__share" data-tpe="share" disabled>
			<svg viewBox="0 0 24 24" aria-hidden="true"
				><path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1"
				></path></svg
			>
			<span data-tpe="share-label">Copy share link</span>
		</button>
	</div>
</section>

<style>
	.tpv {
		position: relative;
		block-size: var(--tp-preview-h, clamp(16rem, 46dvh, 40rem));
		min-inline-size: 0;
		border-block: var(--stroke-hairline) solid var(--rule-strong);
		overflow: clip;
	}
	.tpv__stage {
		position: absolute;
		inset: 0;
	}
	.tpv__stage > :global(*) {
		inline-size: 100%;
		block-size: 100%;
	}
	/* The Prompt view traps scrolling; here it must not, or the band blocks page scroll. */
	.tpv :global([data-tpst="scroller"]) {
		overscroll-behavior: auto;
	}
	.tpv__caption {
		position: absolute;
		inset-block-start: var(--space-3);
		inset-inline-start: var(--space-3);
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-3);
		max-inline-size: calc(100% - 2 * var(--space-3));
		margin: 0;
		padding: var(--space-1) var(--space-3);
		color: var(--ink-muted);
		background: var(--paper);
		border: var(--stroke-hairline) solid var(--rule-strong);
		border-radius: var(--radius-sm);
		pointer-events: none;
	}
	.tpv__actions {
		position: absolute;
		inset-block-end: var(--space-4);
		inset-inline: var(--space-3);
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-2) var(--space-3);
		pointer-events: none;
	}
	.tpv__btn {
		pointer-events: auto;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		box-sizing: border-box;
		min-block-size: 44px;
		padding: 2px 1.25rem 0;
		font-family: var(--font-display);
		font-size: 16px;
		line-height: 20px;
		font-weight: 600;
		letter-spacing: 0.04em;
		border-radius: 0.5rem;
		cursor: pointer;
		white-space: nowrap;
	}
	.tpv__start {
		color: var(--tp-bg, var(--paper));
		background: var(--tp-fg, var(--ink));
		border: 0;
	}
	.tpv__share {
		color: var(--tp-fg, var(--ink));
		background: var(--tp-bg, var(--paper));
		border: var(--stroke-hairline) solid var(--tp-fg, var(--ink));
	}
	.tpv__btn svg {
		inline-size: 24px;
		block-size: 24px;
		flex: none;
		margin-block-start: -2px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	@media (hover: hover) and (pointer: fine) {
		.tpv__start:not(:disabled):hover {
			box-shadow: inset 0 0 0 100vmax color-mix(in srgb, var(--tp-bg, var(--paper)) 14%, transparent);
		}
		.tpv__share:not(:disabled):hover {
			box-shadow: inset 0 0 0 100vmax color-mix(in srgb, var(--tp-fg, var(--ink)) 14%, transparent);
		}
	}
	.tpv__btn:focus-visible {
		outline: 2px solid var(--tp-fg, var(--ink));
		outline-offset: 2px;
	}
	.tpv__btn:disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}
	@media (prefers-reduced-motion: no-preference) {
		.tpv__btn {
			transition: transform 160ms var(--ease-out, ease-out);
		}
		.tpv__btn:not(:disabled):active {
			transform: scale(0.97);
		}
	}
	.tpv__flag {
		color: var(--ink);
	}
	.tpv__flag[hidden] {
		display: none;
	}
</style>
