<div class="tpst" data-tp-stage data-align="left" data-guide="band">
	<div class="tpst-area">
		<div class="tpst-guide" aria-hidden="true">
			<div class="tpst-band"></div>
			<div class="tpst-arrow tpst-arrow-start"></div>
			<div class="tpst-arrow tpst-arrow-end"></div>
		</div>
		<div class="tpst-scroller" data-tpst="scroller" tabindex="-1">
			<div class="tpst-track">
				<div class="tpst-text" data-tpst="text"></div>
			</div>
		</div>
	</div>
</div>

<style>
	.tpst {
		/* Overwritten from settings at runtime; these defaults keep the stage readable before then. */
		--tp-fg: oklch(0.88 0.18 95);
		--tp-bg: oklch(0 0 none);
		--tp-guide: oklch(1 0 none);
		--tp-font: system-ui, sans-serif;
		--tp-weight: 400;
		--tp-size: 56px;
		--tp-lh: 1.5;
		--tp-col: 70%;
		--tp-colpos: 0.5;
		--tp-guide-pos: 0.33;
		--tp-guide-opacity: 0.2;
		--tp-sx: 1;
		--tp-sy: 1;

		--tp-line: calc(var(--tp-size) * var(--tp-lh));
		--tpst-arrow: clamp(0.75rem, calc(var(--tp-size) * 0.35), 1.5rem);
		/* Edge margin, never less than an arrow and its gap, so arrows fit when the column is flush to an edge. */
		--tpst-gutter: max(clamp(1.25rem, 4cqi, 3rem), var(--tpst-arrow) + 0.5rem);
		--tpst-colw: min(var(--tp-col), 100% - 2 * var(--tpst-gutter));
		/* --tp-colpos: 0 flush left, 0.5 centred, 1 flush right. Percentages resolve against the stage, so no measuring on resize. */
		--tpst-colx: calc(var(--tpst-gutter) + (100% - var(--tpst-colw) - 2 * var(--tpst-gutter)) * var(--tp-colpos));

		position: relative;
		display: block;
		inline-size: 100%;
		block-size: 100%;
		/* Size container: cqi and cqb here mean this stage's own box, wherever it sits. */
		container-type: size;
		overflow: clip;
		background: var(--tp-bg);
		color: var(--tp-fg);
	}

	/* Mirror and flip transform only this. Overlays live outside the stage so they always read the right way round. */
	.tpst-area {
		position: absolute;
		inset: 0;
		scale: var(--tp-sx) var(--tp-sy);
	}

	.tpst-scroller {
		position: absolute;
		inset: 0;
		/* hidden, not clip: scripted scrolling needs a scroll container. */
		overflow-x: hidden;
		overflow-y: auto;
		/* Scripted scrollTop writes must land instantly, whatever the page sets. */
		scroll-behavior: auto;
		overscroll-behavior: contain;
		scrollbar-width: none;
		touch-action: pan-y pinch-zoom;
		user-select: none;
		-webkit-user-select: none;
		-webkit-tap-highlight-color: transparent;
	}

	.tpst-scroller::-webkit-scrollbar {
		display: none;
	}

	.tpst-scroller:focus-visible {
		outline: 2px solid transparent;
	}

	/* Padding puts line one on the read line at scrollTop 0. The track is never transformed, so the text's sub-pixel transform can't change scroll height. */
	.tpst-track {
		padding-block-start: max(0px, var(--tp-guide-pos) * 100cqb - var(--tp-line) / 2);
		padding-block-end: max(0px, (1 - var(--tp-guide-pos)) * 100cqb - var(--tp-line) / 2);
	}

	.tpst-text {
		position: relative;
		inline-size: var(--tpst-colw);
		margin-inline-start: var(--tpst-colx);
		font-family: var(--tp-font);
		font-weight: var(--tp-weight);
		font-size: var(--tp-size);
		line-height: var(--tp-lh);
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		will-change: transform;
	}

	.tpst[data-align="center"] .tpst-text {
		text-align: center;
	}

	/* Paragraphs are created at runtime, so their rules must be global. */
	.tpst-text :global(.tpst-para) {
		margin: 0;
		margin-block-end: calc(var(--tp-line) * 0.75);
	}

	.tpst-text :global(.tpst-para:last-child) {
		margin-block-end: 0;
	}

	.tpst-text :global(.tpst-empty) {
		color: color-mix(in oklch, var(--tp-fg) 60%, var(--tp-bg));
	}

	.tpst-guide {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.tpst-band,
	.tpst-arrow {
		position: absolute;
		display: none;
		background: var(--tp-guide);
	}

	.tpst-band {
		inset-inline: 0;
		inset-block-start: calc(var(--tp-guide-pos) * 100cqb - var(--tp-line) / 2);
		block-size: var(--tp-line);
		opacity: var(--tp-guide-opacity);
	}

	.tpst-arrow {
		inset-block-start: calc(var(--tp-guide-pos) * 100cqb - var(--tpst-arrow) / 2);
		inline-size: var(--tpst-arrow);
		block-size: var(--tpst-arrow);
	}

	.tpst-arrow-start {
		inset-inline-start: max(0.125rem, var(--tpst-colx) - var(--tpst-arrow) - 0.375rem);
		clip-path: polygon(0 0, 100% 50%, 0 100%);
	}

	.tpst-arrow-end {
		inset-inline-end: max(0.125rem, 100% - var(--tpst-colx) - var(--tpst-colw) - var(--tpst-arrow) - 0.375rem);
		clip-path: polygon(100% 0, 0 50%, 100% 100%);
	}

	.tpst[data-guide="band"] .tpst-band,
	.tpst[data-guide="arrows"] .tpst-arrow {
		display: block;
	}
</style>
