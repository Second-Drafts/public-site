---
import SeoArticle from "../../components/SeoArticle.astro";
import { faq } from "./faq";
---

<SeoArticle idPrefix="m8-seo" {faq}>
	<section aria-labelledby="m8-seo-how">
		<h2 id="m8-seo-how" class="sd-text-title">How to ask the Magic 8 Ball</h2>
		<ol>
			<li>Type a question, or keep it in your head.</li>
			<li>
				Shake the ball. Press Shake, click or tap the ball, drag it back and forth, or shake your phone.
			</li>
			<li>Wait for the answer to rise into the window.</li>
			<li>Share it as an image if you like.</li>
		</ol>
	</section>

	<section aria-labelledby="m8-seo-writers">
		<h2 id="m8-seo-writers" class="sd-text-title">The writer's deck</h2>
		<p>
			Switch to the writer's deck for answers from the Department, such as "Kill that darling." and "Resubmit in
			triplicate.", for when the question is about the draft.
		</p>
	</section>
</SeoArticle>
