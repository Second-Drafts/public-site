	"categories": {
		"analytics": {
			"requiresConsent": true,
			"label": "Analytics",
			"description": "Helps us understand which pages, tools and settings people use, so we know what to improve. Never includes what you write."
		},
		"forms": {
			"requiresConsent": false,
			"label": "Forms",
			"description": "Sends us what you enter in a form, like a waitlist signup, only when you submit it. Submitting is your consent."
		},
		"necessary": {
			"requiresConsent": false,
			"label": "Strictly necessary",
			"description": "Makes the tools work the way you asked them to, like keeping your work between visits. These stay on your device and are never sent to us."
		}
